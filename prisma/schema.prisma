generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  domain            String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  availabilityRules AvailabilityRule[]
  blockedTimes      BlockedTime[]
  bookings          Booking[]
  businessSettings  BusinessSettings?
  categories        Category[]
  customers         Customer[]
  payments          Payment[]
  services          Service[]
  formTemplates     FormTemplate[]
  formSubmissions   FormSubmission[]
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  clientId           String   @unique
  businessName       String
  address            String?
  phone              String?
  email              String?
  timezone           String   @default("America/New_York")
  cancellationPolicy String?
  latePolicy         String?
  noShowPolicy       String?
  depositPolicy      String?
  updatedAt          DateTime @updatedAt
  client             Client   @relation(fields: [clientId], references: [id])
}

model Category {
  id           String    @id @default(uuid())
  clientId     String
  name         String
  description  String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  client       Client    @relation(fields: [clientId], references: [id])
  services     Service[]

  @@index([clientId])
}

model Service {
  id                  String      @id @default(uuid())
  clientId            String
  categoryId          String
  name                String
  description         String?
  durationMinutes     Int
  price               Decimal     @db.Decimal(10, 2)
  depositAmount       Decimal?    @db.Decimal(10, 2)
  paymentType         PaymentType @default(FULL)
  bufferBeforeMinutes Int         @default(0)
  bufferAfterMinutes  Int         @default(0)
  active              Boolean     @default(true)
  bookings            Booking[]
  category            Category    @relation(fields: [categoryId], references: [id])
  client              Client      @relation(fields: [clientId], references: [id])
  formAssignments     ServiceFormAssignment[]

  @@index([clientId])
  @@index([categoryId])
}

model Customer {
  id       String    @id @default(uuid())
  clientId String
  fullName String
  email    String
  phone    String?
  notes           String?
  isVip           Boolean   @default(false)
  adminNotes      String?
  bookings        Booking[]
  client          Client           @relation(fields: [clientId], references: [id])
  formSubmissions FormSubmission[]

  @@index([clientId])
  @@index([clientId, email])
}

model Booking {
  id                      String        @id @default(uuid())
  clientId                String
  serviceId               String
  customerId              String
  startTimeUtc            DateTime
  endTimeUtc              DateTime
  status                  BookingStatus @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus @default(UNPAID)
  paymentProvider         String?
  paymentId               String?
  confirmationEmailSentAt DateTime?
  reminderEmailSentAt     DateTime?
  notes                   String?
  manageToken             String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  client                  Client           @relation(fields: [clientId], references: [id])
  customer                Customer         @relation(fields: [customerId], references: [id])
  service                 Service          @relation(fields: [serviceId], references: [id])
  payments                Payment[]
  formSubmissions         FormSubmission[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([startTimeUtc, endTimeUtc])
}

model Payment {
  id                String        @id @default(uuid())
  clientId          String
  bookingId         String
  provider          String
  providerPaymentId String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  booking           Booking       @relation(fields: [bookingId], references: [id])
  client            Client        @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([bookingId])
}

model AvailabilityRule {
  id        String  @id @default(uuid())
  clientId  String
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean @default(true)
  client    Client  @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([clientId, dayOfWeek])
}

model BlockedTime {
  id           String   @id @default(uuid())
  clientId     String
  startTimeUtc DateTime
  endTimeUtc   DateTime
  reason       String?
  client       Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([startTimeUtc, endTimeUtc])
}

enum PaymentType {
  FULL
  DEPOSIT
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FormType {
  INTAKE
  CONSENT
  WAIVER
  CUSTOM
}

model FormTemplate {
  id          String    @id @default(uuid())
  clientId    String
  name        String
  description String?
  type        FormType  @default(INTAKE)
  fields      Json      @default("[]")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client             Client                  @relation(fields: [clientId], references: [id])
  serviceAssignments ServiceFormAssignment[]
  submissions        FormSubmission[]

  @@index([clientId])
}

model ServiceFormAssignment {
  id             String   @id @default(uuid())
  serviceId      String
  formTemplateId String
  required       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@unique([serviceId, formTemplateId])
  @@index([serviceId])
}

model FormSubmission {
  id             String   @id @default(uuid())
  clientId       String
  bookingId      String
  customerId     String
  formTemplateId String
  answers        Json     @default("{}")
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  booking      Booking      @relation(fields: [bookingId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [id])

  @@index([bookingId])
  @@index([clientId])
  @@index([formTemplateId])
}
